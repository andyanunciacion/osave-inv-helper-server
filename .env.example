PORT=4000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to http://localhost:3000 (the frontend's dev server) if unset.
ALLOWED_ORIGINS=http://localhost:3000

# Google Cloud Vision credentials for /api/ocr. Paste the full service
# account JSON key as a single-line string (wrap in single quotes so PORT-
# style shells don't mangle the inner double quotes). Alternatively, set
# GOOGLE_APPLICATION_CREDENTIALS to a file path instead (local dev only).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Cost guards for /api/ocr (each accepted request is one billed Vision call).
# Per-IP requests per minute, and a server-wide cap per rolling 24 hours.
OCR_RATE_LIMIT_PER_MINUTE=30
OCR_DAILY_LIMIT=300
